@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<div class="container min-vh-100 d-flex align-items-center justify-content-center py-5">
    <div class="row justify-content-center w-100">
        <div class="col-lg-7 col-md-9">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <div class="d-flex align-items-start gap-3">
                        <!-- Friendly error icon -->
                        <div class="flex-shrink-0">
                            <svg class="bi text-primary" width="48" height="48" viewBox="0 0 16 16" fill="currentColor" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" focusable="false">
                                <path d="M7.001 1a1 1 0 0 1 .998 1v6a1 1 0 0 1-.998 1H6V2a1 1 0 0 1 1-1z" />
                                <path fill-rule="evenodd" d="M8 15A7 7 0 1 0 8 1a7 7 0 0 0 0 14zm0-1A6 6 0 1 1 8 2a6 6 0 0 1 0 12z" />
                                <path d="M7.002 10a1 1 0 1 0 2 0 1 1 0 0 0-2 0z" />
                            </svg>
                        </div>

                        <div class="flex-grow-1">
                            <h1 class="h4 mb-1 text-danger">Something went wrong</h1>
                            <p class="mb-2 text-muted">
                                We couldn't complete your request. This is usually temporary — try refreshing the page or return to the home page.
                            </p>

                            @if (Model.ShowRequestId)
                            {
                                <div class="mb-3 d-flex align-items-center gap-2">
                                    <small class="text-muted">Request ID:</small>
                                    <code id="requestId">@Model.RequestId</code>
                                    <button type="button" class="btn btn-sm btn-outline-secondary" id="copyRequestId" title="Copy Request ID">
                                        Copy
                                    </button>
                                </div>
                            }

                            <div class="d-flex flex-wrap gap-2">
                                <a asp-controller="Home" asp-action="Index" class="btn btn-primary">
                                    Go to Home
                                </a>
          
                                <a class="btn btn-link text-decoration-none" href="mailto:service@uj.ac.za?subject=Error%20Report@(Model.ShowRequestId? System.Uri.EscapeDataString(" - Request ID: " + Model.RequestId) : "")">
                                    Contact support
                                </a>
                            </div>

                            <div class="mt-3">
                                <small class="text-muted">
                                    If you continue seeing this message, please contact support and include the Request ID shown above so we can investigate.
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/site.js?v=@DateTime.Now.Ticks"></script>
}