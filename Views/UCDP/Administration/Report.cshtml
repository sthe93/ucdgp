@using ResearchSuite.Helpers
@using ResearchSuite.Helpers.Ucdp
@using ResearchSuite.Models.UCDP.Enums
@model ResearchSuite.Models.UCDP.ProgressReportDetailsViewModel
@{
    ViewData["Title"] = "Create Progress Report";
    var user = Context.User;
    var userRoles = UserHelper.GetRolesForApp(user, "ucdg");

    bool IsApplicant() =>
        userRoles.Any(r =>
        r.Equals("applicant", StringComparison.OrdinalIgnoreCase));

    bool IsFA() =>
       userRoles.Any(r =>
       r.Equals("fund administrator", StringComparison.OrdinalIgnoreCase));

    bool IsMoviationalLetterMandatory() =>
        Model.FundingCallStartDate.Year < (DateTime.Now.Year) && !Model.IsViewOnly;
}

<section class="py-4">
    <div class="form-section mb-4" style="padding:20px">
        <div class="d-flex justify-content-between align-items-center border-orange-line mb-4">
            <h2 class="text-orange mb-0">Progress Report</h2>
        </div>

        <input type="hidden" value="@Model.Username" id="Username" name="Username">
        <input type="hidden" value="@Model.FundingCallId" id="FundingCallId" name="FundingCallId">
        <input type="hidden" value="@Model.ApplicationId" id="ApplicationId" name="ApplicationId">
        <input type="hidden" value="@Model.Id" id="ReportId" name="ReportId">
        <input type="hidden" value="@Model.IsViewOnly" id="IsViewOnly" name="IsViewOnly">
        <input type="hidden" value="@IsApplicant()" id="IsApplicant" name="IsApplicant">
        <input type="hidden" value="@Model.ViewReportSource" id="ViewReportSource" name="ViewReportSource">
        <input type="hidden" value="@IsMoviationalLetterMandatory()" id="IsMoviationalLetterMandatory" name="IsMoviationalLetterMandatory">
        <!-- Tabs -->
        <div class="card">
            <div class="card-body">
                <ul class="nav nav-tabs mb-3" id="reportTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="recipient-tab" data-bs-toggle="tab" data-bs-target="#recipient" type="button" role="tab" aria-controls="recipient" aria-selected="true">
                            <i class="bi bi-person-fill me-1"></i> Grant Recipient Details
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button @(!Model.IsViewOnly ? "disabled" : "") class="nav-link" id="qualification-tab" data-bs-toggle="tab" data-bs-target="#qualification" type="button" role="tab" aria-controls="qualification" aria-selected="false">
                            <i class="bi bi-mortarboard-fill me-1"></i> Qualifications
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button @(!Model.IsViewOnly ? "disabled" : "") class="nav-link" id="teaching-tab" data-bs-toggle="tab" data-bs-target="#teaching" type="button" role="tab" aria-controls="teaching" aria-selected="false">
                            <i class="bi bi-pencil-square me-1"></i> Teaching Relief Appointment
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button @(!Model.IsViewOnly ? "disabled" : "") class="nav-link" id="publications-tab" data-bs-toggle="tab" data-bs-target="#publications" type="button" role="tab" aria-controls="publications" aria-selected="false">
                            <i class="bi bi-journal-text me-1"></i> Publications
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button @(!Model.IsViewOnly ? "disabled" : "") class="nav-link" id="projects-tab" data-bs-toggle="tab" data-bs-target="#projects" type="button" role="tab" aria-controls="projects" aria-selected="false">
                            <i class="bi bi-search me-1"></i> Research Projects
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button @(!Model.IsViewOnly ? "disabled" : "") class="nav-link" id="collab-tab" data-bs-toggle="tab" data-bs-target="#collab" type="button" role="tab" aria-controls="collab" aria-selected="false">
                            <i class="bi bi-people-fill me-1"></i> Collaborative Projects
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button @(!Model.IsViewOnly ? "disabled" : "") class="nav-link" id="motivational-tab" data-bs-toggle="tab" data-bs-target="#motivational" type="button" role="tab" aria-controls="motivational" aria-selected="false">
                            <i class="bi bi-postcard me-1"></i> Motivational Letter
                            @if (IsMoviationalLetterMandatory())
                            {
                                <span class="text-danger">*</span>
                            }
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button @(!Model.IsViewOnly ? "disabled" : "") class="nav-link" id="financial-tab" data-bs-toggle="tab" data-bs-target="#financial" type="button" role="tab" aria-controls="financial" aria-selected="false">
                            <i class="bi bi-cash-stack me-1"></i> Financial Report
                        </button>
                    </li>

                </ul>

                <div class="tab-content">
                    <!-- Recipient tab (example form layout matching codebase patterns) -->
                    <div class="tab-pane fade show active" id="recipient" role="tabpanel" aria-labelledby="recipient-tab">
                        <div class="mb-3" style="background:#ff6a00;color:#fff;padding:8px 12px;border-radius:2px;">Grant Recipient Details</div>

                        <form id="createReportForm" class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label">Employee number</label>
                                <input type="text" class="form-control" id="StaffNumber" name="StaffNumber" asp-for="StaffNumber" value="@Model.StaffNumber.Remove(Model.StaffNumber.Length - 5, 5)*******" required disabled />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Title</label>
                                <input type="text" class="form-control" id="Title" name="Title" asp-for="Title" value="@("*****")"  required disabled />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">First Name</label>
                                <input type="text" class="form-control" id="FirstName" name="FirstName" asp-for="FirstName" required disabled />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Surname</label>
                                <input type="text" class="form-control" id="Surname" name="Surname" asp-for="Surname" required disabled />
                            </div>

                            <div class="col-md-6">
                                <label class="form-label">Project Funded as Approved (in Rands)</label>
                                <input type="text" class="form-control" id="ApprovedAmount" name="ApprovedAmount" asp-for="ApprovedAmount" required disabled value="@TextFormatHelper.FormatCurrency(Model.ApprovedAmount)" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Category of applicant or for a target group</label>
                                <input type="text" class="form-control" id="ApplicantCategory" name="ApplicantCategory" asp-for="ApplicantCategory" required disabled />
                            </div>

                            <div class="col-12 d-flex justify-content-between mt-3">
                                <a class="btn btn-secondary closeBtn"><i class="bi bi-x-circle me-1"></i> Close</a>
                                @if (Model.IsViewOnly)
                                {
                                    <button type="button" class="btn btn-success" id="btnNextToQualification"> Next <i class="bi bi-chevron-right me-1"></i></button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-success" id="btnNextToQualification"><i class="bi bi-floppy me-1"></i> Next <i class="bi bi-chevron-right me-1"></i></button>
                                }
                            </div>
                        </form>
                    </div>

                    <!-- Qualification tab (placeholder) -->
                    <div class="tab-pane fade" id="qualification" role="tabpanel" aria-labelledby="qualification-tab">
                        <div class="mb-3" style="background:#ff6a00;color:#fff;padding:8px 12px;border-radius:2px;">Qualifications</div>

                        <form id="qualificationForm" class="row g-3">
                            <div class="col-12 d-flex align-items-center justify-content-between">
                                <div>
                                    <label class="form-label mb-0">Qualification Mode</label>
                                    <div class="small text-muted">Select whether the qualification is still in progress or already graduated.</div>
                                </div>

                                <!-- Switch / radio group (matches NewSubmission style concept) -->
                                <div>
                                    <div class="btn-group" role="group" aria-label="Qualification mode">
                                        <input type="radio" class="btn-check" asp-for="IsQualificationInProgressMode" id="QualificationModeInProgress" autocomplete="off" value="true" disabled="@Model.IsViewOnly">
                                        <label class="btn btn-outline-secondary btn-sm" for="QualificationModeInProgress">In Progress</label>

                                        <input type="radio" class="btn-check" asp-for="IsQualificationInProgressMode" id="QualificationModeGraduated" autocomplete="off" value="false" disabled="@Model.IsViewOnly">
                                        <label class="btn btn-outline-secondary btn-sm" for="QualificationModeGraduated">Graduated</label>
                                    </div>
                                </div>
                            </div>

                            <input type="hidden" asp-for="IsQualificationInProgressMode" id="IsQualificationInProgressMode" name="IsQualificationInProgressMode" />
                            <input type="hidden" asp-for="IsQualificationInPrgress" id="IsQualificationInPrgress" name="IsQualificationInPrgress" />
                            <input type="hidden" asp-for="IsQualificationGraduated" id="IsQualificationGraduated" name="IsQualificationGraduated" />
                            <hr />
                            <div id="inProgressSection" class="row g-3">
                                @if ((Model.IsQualificationInPrgress && Model.IsViewOnly) || !Model.IsViewOnly)
                                {
                                    <div class="col-md-6 inProgressInnerSection">
                                        <label class="form-label">Qualification <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="QualificationName" name="QualificationName" asp-for="QualificationName" required disabled="@Model.IsViewOnly" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Planned Graduation Year <span class="text-danger">*</span></label>
                                        <input type="text" class="form-control" id="QualificationInPrgressGraduationYear" name="QualificationInPrgressGraduationYear" asp-for="QualificationInPrgressGraduationYear" required disabled="@Model.IsViewOnly" />
                                    </div>

                                }
                                @if ((Model.IsQualificationInPrgress && Model.IsViewOnly) || !Model.IsViewOnly)
                                {
                                    <div class="inProgressInnerSection">
                                        <div class="col-12">
                                            <label class="form-label">Field of Study <span class="text-danger">*</span></label>
                                            <textarea class="form-control" id="QualificationInPrgressFieldOfStudy" name="QualificationInPrgressFieldOfStudy" asp-for="QualificationInPrgressFieldOfStudy" rows="3" required disabled="@Model.IsViewOnly"></textarea>
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label">Title of Thesis <span class="text-danger">*</span></label>
                                            <textarea class="form-control" id="QualificationInPrgressTitleofThesis" name="QualificationInPrgressTitleofThesis" asp-for="QualificationInPrgressTitleofThesis" rows="3" required disabled="@Model.IsViewOnly"></textarea>
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label">Institution Registered With <span class="text-danger">*</span></label>
                                            <textarea class="form-control" id="QualificationInPrgressInstitution" name="QualificationInPrgressInstitution  " asp-for="QualificationInPrgressInstitution" rows="3" required disabled="@Model.IsViewOnly"></textarea>
                                        </div>

                                        <div class="col-12 mt-3">
                                            <ul class="nav nav-tabs" id="qualificationDocsTabs" role="tablist">
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link active" id="proof-tab" data-bs-toggle="tab" data-bs-target="#proof" type="button" role="tab" aria-controls="proof" aria-selected="true">Proof Of Registration</button>
                                                </li>
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link" id="supervisor-tab" data-bs-toggle="tab" data-bs-target="#supervisor" type="button" role="tab" aria-controls="supervisor" aria-selected="false">Progress Report from Supervisor</button>
                                                </li>
                                            </ul>

                                            <div class="tab-content border p-3 pt-2" style="border-top:0;">
                                                <div class="tab-pane fade show active" id="proof" role="tabpanel" aria-labelledby="proof-tab">
                                                    <div class="alert alert-warning mb-3 p-2"><strong>Please attach documents as requested to submit your application</strong></div>
                                                    <div class="small text-muted mb-2">Only pdf documents are allowed. If more than 1 document, create a single file. (Max 5 MB).</div>

                                                    <div class="d-flex align-items-center mb-2">
                                                        <input type="file" id="proofFile" accept="application/pdf" class="form-control form-control-sm" disabled="@Model.IsViewOnly" />
                                                        <button type="button" id="btnAddProof" class="btn btn-info btn-sm ms-2" disabled="@Model.IsViewOnly">Add Document(s)</button>
                                                    </div>

                                                    <ul id="proofFilesList" class="list-unstyled mb-0">
                                                        @if (Model.ApplicationDocuments != null && Model.ApplicationDocuments.Any())
                                                        {
                                                            var fileExists = false;
                                                            foreach (var doc in Model.ApplicationDocuments)
                                                            {
                                                                if (doc.UploadType.Trim() == ProgressReportUploadTypeEnum.ProofOfReg.GetDescription())
                                                                {
                                                                    fileExists = true;
                                                                    <li class="py-2 border-bottom d-flex justify-content-between align-items-center">
                                                                        <span>@doc.Filename</span>
                                                                        <span>
                                                                            <button type="button"
                                                                                    class="btn btn-outline-primary btn-sm view-file"
                                                                                    data-document-id="@doc.DocumentId"
                                                                                    data-filename="@doc.Filename"
                                                                                    data-docurl="@Url.Action("ViewDocument", "Administration", new { documentId = doc.DocumentId })">
                                                                                <i class="bi bi-eye"></i> View
                                                                            </button>
                                                                            <button type="button" class="btn btn-link p-0 text-danger delete-file" data-document-id="@doc.DocumentId" data-filename="@doc.Filename" disabled="@Model.IsViewOnly">
                                                                                <i class="bi bi-trash"></i> Delete
                                                                            </button>
                                                                        </span>
                                                                    </li>
                                                                }
                                                            }
                                                            if (!fileExists)
                                                            {
                                                                <li class="py-2 text-muted">No documents attached.</li>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <li class="py-2 text-muted">No documents attached.</li>
                                                        }
                                                    </ul>
                                                </div>

                                                <div class="tab-pane fade" id="supervisor" role="tabpanel" aria-labelledby="supervisor-tab">
                                                    <div class="alert alert-warning mb-3 p-2"><strong>Please attach documents as requested to submit your application</strong></div>
                                                    <div class="small text-muted mb-2">Only pdf documents are allowed. If more than 1 document, create a single file. (Max 5 MB).</div>

                                                    <div class="d-flex align-items-center mb-2">
                                                        <input type="file" id="supervisorFile" accept="application/pdf" class="form-control form-control-sm" disabled="@Model.IsViewOnly" />
                                                        <button type="button" id="btnAddSupervisor" class="btn btn-info btn-sm ms-2" disabled="@Model.IsViewOnly">Add Document(s)</button>
                                                    </div>

                                                    <ul id="supervisorFilesList" class="list-unstyled mb-0">
                                                        @if (Model.ApplicationDocuments != null && Model.ApplicationDocuments.Any())
                                                        {
                                                            var fileExists = false;
                                                            foreach (var doc in Model.ApplicationDocuments)
                                                            {
                                                                if (doc.UploadType.Trim() == ProgressReportUploadTypeEnum.SupervisorReport.GetDescription())
                                                                {
                                                                    fileExists = true;
                                                                    <li class="py-2 border-bottom d-flex justify-content-between align-items-center">
                                                                        <span>@doc.Filename</span>
                                                                        <span>
                                                                            <button type="button"
                                                                                    class="btn btn-outline-primary btn-sm view-file"
                                                                                    data-document-id="@doc.DocumentId"
                                                                                    data-filename="@doc.Filename"
                                                                                    data-docurl="@Url.Action("ViewDocument", "Administration", new { documentId = doc.DocumentId })">
                                                                                <i class="bi bi-eye"></i> View
                                                                            </button>
                                                                            <button type="button" class="btn btn-link p-0 text-danger delete-file" data-document-id="@doc.DocumentId" data-filename="@doc.Filename" disabled="@Model.IsViewOnly">
                                                                                <i class="bi bi-trash"></i> Delete
                                                                            </button>
                                                                        </span>
                                                                    </li>
                                                                }
                                                            }
                                                            if (!fileExists)
                                                            {
                                                                <li class="py-2 text-muted">No documents attached.</li>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <li class="py-2 text-muted">No documents attached.</li>
                                                        }
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                <div class="col-12 d-flex justify-content-between mt-4">
                                    <button type="button" class="btn btn-dark" id="btnBackToRecipient"><i class="bi bi-chevron-left me-1"></i> Back</button>
                                    <div>
                                        <a class="btn btn-secondary closeBtn"><i class="bi bi-x-circle me-1"></i> Close</a>
                                        @if (Model.IsViewOnly)
                                        {
                                            <button type="button" class="btn btn-success" id="btnNextToGraduated"> Next <i class="bi bi-chevron-right me-1"></i></button>
                                        }
                                        else
                                        {
                                            <button type="button" class="btn btn-success" id="btnNextToGraduated"><i class="bi bi-floppy me-1"></i> Next <i class="bi bi-chevron-right me-1"></i></button>
                                        }
                                    </div>
                                </div>
                            </div>
                            <div id="graduatedSection" class="row g-3" style="display:none">
                                @if ((Model.IsQualificationGraduated && Model.IsViewOnly) || !Model.IsViewOnly)
                                {
                                    <div class="col-md-6 graduatedSectionInnerSection">
                                        <label class="form-label">Qualification</label>
                                        <input type="text" class="form-control" id="QualificationGraduatedName" name="QualificationGraduatedName" asp-for="QualificationGraduatedName" required disabled="@Model.IsViewOnly" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label">Year of Graduation</label>
                                        <input type="text" class="form-control" id="QualificationGraduatedYear" name="QualificationGraduatedYear" asp-for="QualificationGraduatedYear" required disabled="@Model.IsViewOnly" />
                                    </div>
                                }

                                @if ((Model.IsQualificationGraduated && Model.IsViewOnly) || !Model.IsViewOnly)
                                {
                                    <div class="graduatedSectionInnerSection">
                                        <div class="col-12">
                                            <label class="form-label">Field of Study</label>
                                            <textarea class="form-control" id="QualificationGraduatedFieldOfStudy" name="QualificationGraduatedFieldOfStudy" asp-for="QualificationGraduatedFieldOfStudy" rows="3" required disabled="@Model.IsViewOnly"></textarea>
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label">Title of Thesis</label>
                                            <textarea class="form-control" id="QualificationGraduatedTitleofThesis" name="QualificationGraduatedTitleofThesis" asp-for="QualificationGraduatedTitleofThesis" rows="3" required disabled="@Model.IsViewOnly"></textarea>
                                        </div>

                                        <div class="col-12">
                                            <label class="form-label">Institution Registered With</label>
                                            <textarea class="form-control" id="QualificationGraduatedInstitution" name="QualificationGraduatedInstitution" asp-for="QualificationGraduatedInstitution" rows="3" required disabled="@Model.IsViewOnly"></textarea>
                                        </div>

                                        <div class="col-12 mt-3">
                                            <ul class="nav nav-tabs" id="qualificationGraduationDocsTabs" role="tablist">
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link active" id="proof-grad-tab" data-bs-toggle="tab" data-bs-target="#proofGrad" type="button" role="tab" aria-controls="proofGrad" aria-selected="true">Proof Of Graduation</button>
                                                </li>
                                                <li class="nav-item" role="presentation">
                                                    <button class="nav-link" id="supervisor-grad-tab" data-bs-toggle="tab" data-bs-target="#supervisorGrad" type="button" role="tab" aria-controls="supervisorGrad" aria-selected="false">Graduation Report from Supervisor</button>
                                                </li>
                                            </ul>

                                            <div class="tab-content border p-3 pt-2" style="border-top:0;">
                                                <div class="tab-pane fade show active" id="proofGrad" role="tabpanel" aria-labelledby="proof-grad-tab">
                                                    <div class="alert alert-warning mb-3 p-2"><strong>Please attach documents as requested to submit your application</strong></div>
                                                    <div class="small text-muted mb-2">Only pdf documents are allowed. If more than 1 document, create a single file. (Max 5 MB).</div>

                                                    <div class="d-flex align-items-center mb-2">
                                                        <input type="file" id="proofGradFile" accept="application/pdf" class="form-control form-control-sm" disabled="@Model.IsViewOnly" />
                                                        <button type="button" id="btnAddGradProof" class="btn btn-info btn-sm ms-2" disabled="@Model.IsViewOnly">Add Document(s)</button>
                                                    </div>

                                                    <ul id="proofGradFilesList" class="list-unstyled mb-0">
                                                        @if (Model.ApplicationDocuments != null && Model.ApplicationDocuments.Any())
                                                        {
                                                            var fileExists = false;
                                                            foreach (var doc in Model.ApplicationDocuments)
                                                            {
                                                                if (doc.UploadType.Trim() == ProgressReportUploadTypeEnum.ProofOfGraduation.GetDescription())
                                                                {
                                                                    fileExists = true;
                                                                    <li class="py-2 border-bottom d-flex justify-content-between align-items-center">
                                                                        <span>@doc.Filename</span>
                                                                        <span>
                                                                            <button type="button"
                                                                                    class="btn btn-outline-primary btn-sm view-file"
                                                                                    data-document-id="@doc.DocumentId"
                                                                                    data-filename="@doc.Filename"
                                                                                    data-docurl="@Url.Action("ViewDocument", "Administration", new { documentId = doc.DocumentId })">
                                                                                <i class="bi bi-eye"></i> View
                                                                            </button>
                                                                            <button type="button" class="btn btn-link p-0 text-danger delete-file" data-document-id="@doc.DocumentId" data-filename="@doc.Filename" disabled="@Model.IsViewOnly">
                                                                                <i class="bi bi-trash"></i> Delete
                                                                            </button>
                                                                        </span>
                                                                    </li>
                                                                }
                                                            }
                                                            if (!fileExists)
                                                            {
                                                                <li class="py-2 text-muted">No documents attached.</li>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <li class="py-2 text-muted">No documents attached.</li>
                                                        }
                                                    </ul>
                                                </div>

                                                <div class="tab-pane fade" id="supervisorGrad" role="tabpanel" aria-labelledby="supervisor-grad-tab">
                                                    <div class="alert alert-warning mb-3 p-2"><strong>Please attach documents as requested to submit your application</strong></div>
                                                    <div class="small text-muted mb-2">Only pdf documents are allowed. If more than 1 document, create a single file. (Max 5 MB).</div>

                                                    <div class="d-flex align-items-center mb-2">
                                                        <input type="file" id="supervisorGradFile" accept="application/pdf" class="form-control form-control-sm" disabled="@Model.IsViewOnly" />
                                                        <button type="button" id="btnAddSupervisorGrad" class="btn btn-info btn-sm ms-2" disabled="@Model.IsViewOnly">Add Document(s)</button>
                                                    </div>

                                                    <ul id="supervisorGradFilesList" class="list-unstyled mb-0">
                                                        @if (Model.ApplicationDocuments != null && Model.ApplicationDocuments.Any())
                                                        {
                                                            var fileExists = false;
                                                            foreach (var doc in Model.ApplicationDocuments)
                                                            {
                                                                if (doc.UploadType.Trim() == ProgressReportUploadTypeEnum.SupervisorGraduationLetter.GetDescription())
                                                                {
                                                                    fileExists = true;
                                                                    <li class="py-2 border-bottom d-flex justify-content-between align-items-center">
                                                                        <span>@doc.Filename</span>
                                                                        <span>
                                                                            <button type="button"
                                                                                    class="btn btn-outline-primary btn-sm view-file"
                                                                                    data-document-id="@doc.DocumentId"
                                                                                    data-filename="@doc.Filename"
                                                                                    data-docurl="@Url.Action("ViewDocument", "Administration", new { documentId = doc.DocumentId })">
                                                                                <i class="bi bi-eye"></i> View
                                                                            </button>
                                                                            <button type="button" class="btn btn-link p-0 text-danger delete-file" data-document-id="@doc.DocumentId" data-filename="@doc.Filename" disabled="@Model.IsViewOnly">
                                                                                <i class="bi bi-trash"></i> Delete
                                                                            </button>
                                                                        </span>
                                                                    </li>
                                                                }
                                                            }
                                                            if (!fileExists)
                                                            {
                                                                <li class="py-2 text-muted">No documents attached.</li>
                                                            }
                                                        }
                                                        else
                                                        {
                                                            <li class="py-2 text-muted">No documents attached.</li>
                                                        }
                                                    </ul>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                }
                                <div class="col-12 d-flex justify-content-between mt-4">
                                    <button type="button" class="btn btn-dark" id="btnBackToInProgress"><i class="bi bi-chevron-left me-1"></i> Back</button>
                                    <div>
