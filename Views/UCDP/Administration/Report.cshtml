                                                    <li class="py-2 border-bottom d-flex justify-content-between align-items-center">
                                                        <span>@Model.MotivationalLetter.Filename</span>
                                                        <span>
                                                            <button type="button"
                                                                    class="btn btn-outline-primary btn-sm view-file"
                                                                    data-document-id="@Model.MotivationalLetter.Id"
                                                                    data-filename="@Model.MotivationalLetter.Filename"
                                                                    data-docurl="@Url.Action("ViewMotivationLetterById", "Applications", new { documentId = Model.MotivationalLetter.Id })">
                                                                <i class="bi bi-eye"></i> View
                                                            </button>
                                                            <button type="button" class="btn btn-link p-0 text-danger delete-file" data-ismotivationalletter="true" data-document-id="@Model.MotivationalLetter.Id" data-filename="@Model.MotivationalLetter.Filename" disabled="@Model.IsViewOnly">
                                                                <i class="bi bi-trash"></i> Delete
                                                            </button>
                                                        </span>
                                                    </li>
                                                }
                                                else
                                                {
                                                    <li class="py-2 text-muted">No documents attached.</li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 d-flex justify-content-between mt-3">
                                <button type="button" class="btn btn-dark" id="btnBackToCollab"><i class="bi bi-chevron-left me-1"></i> Back</button>

                                <div>
                                    <a class="btn btn-secondary closeBtn"><i class="bi bi-x-circle me-1"></i> Close</a>
                                    @if (Model.IsViewOnly)
                                    {
                                        <button type="button" class="btn btn-success" id="btnNextToFinancialReport"> Next <i class="bi bi-chevron-right me-1"></i></button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-success" id="btnNextToFinancialReport"><i class="bi bi-floppy me-1"></i> Next <i class="bi bi-chevron-right me-1"></i></button>
                                    }
                                </div>
                            </div>
                        </form>
                    </div>

                    <!-- Financial tab (placeholder) -->
                    <div class="tab-pane fade" id="financial" role="tabpanel" aria-labelledby="financial-tab">
                        <div class="mb-3" style="background:#ff6a00;color:#fff;padding:8px 12px;border-radius:2px;">
                            Financial Report
                            <div class="small" style="opacity:.95; margin-top:6px;">
                                NB: Upload financial report/statement of account from the research cost centre (where the UCDP funds were transferred).
                            </div>
                        </div>
                        <div class="tab-content border p-3 pt-2" style="border-top:0;">
                            <div class="tab-pane fade show active" id="financialReport" role="tabpanel" aria-labelledby="financialReportTab">
                                <div class="alert alert-warning mb-3 p-2"><strong>Please attach documents as requested to submit your application</strong></div>
                                <div class="small text-muted mb-2">Only pdf documents are allowed. Maximum of <b>seven</b> documents can be uploaded. (Max 5 MB).</div>
                                <div class="d-flex align-items-center mb-2">
                                    <input type="file" id="financialReportFile" accept="application/pdf" class="form-control form-control-sm" disabled="@Model.IsViewOnly" />
                                    <button type="button" id="btnAddfinancialReport" class="btn btn-info btn-sm ms-2" disabled="@Model.IsViewOnly">Add Document(s)</button>
                                </div>

                                <ul id="financialReportFilesList" class="list-unstyled mb-0">
                                    @if (Model.ApplicationDocuments != null && Model.ApplicationDocuments.Any())
                                    {
                                        var fileExists = false;
                                        foreach (var doc in Model.ApplicationDocuments)
                                        {
                                            if (doc.UploadType.Trim() == ProgressReportUploadTypeEnum.FinancialReport.GetDescription())
                                            {
                                                fileExists = true;
                                                <li class="py-2 border-bottom d-flex justify-content-between align-items-center">
                                                    <span>@doc.Filename</span>
                                                    <span>
                                                        <button type="button"
                                                                class="btn btn-outline-primary btn-sm view-file"
                                                                data-document-id="@doc.DocumentId"
                                                                data-filename="@doc.Filename"
                                                                data-docurl="@Url.Action("ViewDocument", "Administration", new { documentId = doc.DocumentId })">
                                                            <i class="bi bi-eye"></i> View
                                                        </button>
                                                        <button type="button" class="btn btn-link p-0 text-danger delete-file" data-document-id="@doc.DocumentId" data-filename="@doc.Filename" disabled="@Model.IsViewOnly">
                                                            <i class="bi bi-trash"></i> Delete
                                                        </button>
                                                    </span>
                                                </li>
                                            }
                                        }
                                        if (!fileExists)
                                        {
                                            <li class="py-2 text-muted">No documents attached.</li>
                                        }
                                    }
                                    else
                                    {
                                        <li class="py-2 text-muted">No documents attached.</li>
                                    }
                                </ul>
                            </div>
                        </div>

                        <div class="col-12 d-flex justify-content-between mt-3">
                            <button type="button" class="btn btn-dark" id="btnBackToMotivationalLetter"><i class="bi bi-chevron-left me-1"></i> Back</button>
                            <div>
                                @if (Model.Status == "New" && IsFA())
                                {
                                    <button id="btnReturnForInformation" type="button" class="btn btn-primary" style="background-color: #2c0740;" data-dismiss="modal">Return for information</button>
                                }
                                <a class="btn btn-secondary closeBtn"><i class="bi bi-x-circle me-1"></i> Close</a>
                                @if (Model.Status == "New" && IsFA())
                                {
                                    <button type="button" class="btn btn-success" id="btnFinalizeReport"><i class="bi bi-check-square me-1"></i> Finalise</button>
                                }
                                else if (Model.Status != "New" && IsFA())
                                {
                                    <button type="button" class="btn btn-success" id="btnDoneFA"><i class="bi bi-check-square me-1"></i> Done</button>
                                }
                                else
                                {
                                    <button type="button" class="btn btn-success" id="btnDone"><i class="bi bi-check-square me-1"></i> Done</button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Terms and Conditions modal -->
<div class="modal fade" id="termsModal" tabindex="-1" aria-labelledby="termsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <!-- Top accent to match other UCDP styling -->
            <div style=""></div>
            <div class="modal-header">
                <h5 class="modal-title" id="termsModalLabel">Terms and Conditions</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    This form allows a ONCE off submission. No corrections and/or amendments can be made. Would you like to proceed with your submission?
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" id="termsCancel" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" id="termsProceed" class="btn btn-success" style="background:#ff6a00;border-color:#ff6a00;">Proceed</button>
            </div>
        </div>
    </div>
</div>

<!-- Return for ammendment modal -->
<div class="modal fade" id="addRetunForInfoCommentsModal" tabindex="-1" aria-labelledby="commentsModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:#ff6a00;color:#fff;">
                <h5 class="modal-title" id="commentsModalLabel">Return for information</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label for="retunForInfoComments" class="form-label small text-muted">Enter reason for returning the report (max 300 chars)</label>
                <textarea id="retunForInfoComments" name="comment" maxlength="300" rows="6" class="form-control" placeholder="Enter comments here..."></textarea>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary rfiModalCloseBtn" data-bs-dismiss="modal">Close</button>
                <button id="btnSubmitRetunForInfo" type="button" class="btn" style="background:#ff6a00;color:#fff;border-color:#ff6a00;">Submit</button>
            </div>
        </div>
    </div>
</div>

<!-- Document viewer modal (used to view uploaded PDF files) -->
<div class="modal fade" id="documentViewerModal" tabindex="-1" aria-labelledby="documentViewerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="documentViewerModalLabel">View Document</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <iframe id="documentViewerIframe" src="" width="100%" height="700px" style="border:0;"></iframe>
            </div>
        </div>
    </div>
</div>

<!-- Return for ammendment modal -->
<div class="modal fade" id="deleteFileModal" tabindex="-1" aria-labelledby="deleteFileModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background:#ff6a00;color:#fff;">
                <h5 class="modal-title" id="commentsModalLabel">Delete File</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <label for="deleteFileComments" class="form-label small text-muted">Are you sure you want to delete this file?</label>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-secondary deleteModalCloseBtn" data-bs-dismiss="modal">Close</button>
                <button id="btnSubmitDeleteFile" type="button" class="btn" style="background:#ff6a00;color:#fff;border-color:#ff6a00;">Delete</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ucdp/report.js"></script>
}
