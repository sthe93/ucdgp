@using ResearchSuite.Models.UCDP
@model CreateDocumentViewModel

<li class="py-2 border-bottom d-flex justify-content-between align-items-center">
    <span>@Model.Filename</span>
    <span>
        <button type="button"
                class="btn btn-outline-primary btn-sm view-file"
                data-document-id="@Model.DocumentId"
                data-filename="@Model.Filename"
                data-docurl="@Url.Action("ViewDocument", "Administration", new { documentId = Model.DocumentId })">
            <i class="bi bi-eye"></i> View
        </button>
        <button type="button" class="btn btn-link p-0 text-danger delete-file"
                data-document-id="@Model.DocumentId"
                data-filename="@Model.Filename"
                disabled>
            <i class="bi bi-trash"></i> Delete
        </button>
    </span>
</li>