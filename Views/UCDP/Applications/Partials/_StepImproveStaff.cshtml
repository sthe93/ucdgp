                                                                                <input type="text" id="txtIDNumber" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                                            </td>

                                                                            <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                                                <input type="text" id="txtStatus" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                                            </td>

                                                                            <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">
                                                                                <input type="button" value="Remove" onclick="RemoveAppointment(this)" />
                                                                            </td>
                                                                        </tr>
                        }
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                    <input type="text" id="txtSurname" placeholder="Surname" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                </td>

                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                    <input type="text" id="txtName" placeholder="Name" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                </td>

                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                    <input type="email" id="txtEmailAddress" placeholder="Email Address" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                </td>

                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                    <input type="tel" maxlength="10" id="txtNumber" placeholder="Contact Number" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />
                                                </td>

                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                    <input type="date" defaultValue="@dtToday"  max="@dtLastDay" min="@dtToday" id="txtStartDate" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                </td>

                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                    <input type="date" defaultValue="@dtToday"  max="@dtLastDay" min="@dtToday" id="txtEndDate" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                </td>

                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                    <input type="text" id="txtValidateIDNumber" placeholder="ID Number/Passport number" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                </td>

                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                    <input type="text" id="txtValidateStatus" disabled="disabled" placeholder="Sfaff Status" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                </td>

                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">
                                                    <input type="button" style="height:30px; width:68px" onclick="Verify()" id="btnVerify" value="Verify" />
                                                </td>


                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">
                                                    <input type="button" style="height:30px; width:68px" onclick="AddRow()" id="btnAdd" value="Add" />
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>
                                    <br />
                                </div>

                                <br />

                                <div class="col-md-12" style="background-color: #FF6400; padding: 10px 15px; border-top-left-radius: 3px; border-bottom-left-radius: 3px">
                                    <h3 style="font-size:22px; font-weight:bold" class="panel-title"> Teaching relief for study & research purposes</h3>
                                    <label style="color:white; font-size:small">(Payments will be monthly)</label>
                                </div>

                                <br />



                                <div style="overflow: auto; overflow-y: hidden;" class="col-md-12">
                                    <br />
                                    <p style="width:990px">
                                        Once the replacement lecturer has been appointed, please send the following documents to <strong><a href="mailto:ucdp@uj.ac.za">ucdp@uj.ac.za</a></strong> as proof of appointment:
                                        <ul>
                                            <li>HR appointment letter.</li>
                                            <li>A certified copy of the Highest Qualification.</li>
                                            <li>A certified copy of ID or passport.</li>
                                        </ul>
                                    </p>
                                    <hr />
                                    <label>Schedule for the academic calendar</label>
                                    <br />
                                    <table id="tblPayments">
                                        <thead>
                                            <tr style="border-bottom: 1px solid #e2e2e2;">
                                                  <th style="width:10px; display:none;">Type of study & research purpose</th>
                                                <th style="width:150px">Type of study & research purpose</th>

                                                <th style="width:150px">From &nbsp;<i class="fa fa-info-circle" aria-hidden="true" data-toggle="tooltip" title="Temporary staff appointment FROM date" style="font-weight:bold; font-size:large"></i></th>

                                                <th style="width:150px">To&nbsp;<i class="fa fa-info-circle" aria-hidden="true" data-toggle="tooltip" title="Temporary staff appointment TO date" style="font-weight:bold; font-size:large"></i></th>

                                                <th style="width:150px">Number of Weeks</th>

                                                <th style="width:150px">Hours Per Week</th>

                                                <th style="width:150px">Total Number of Hours</th>

                                                <th style="width:150px">UJ Rate Per Hour <a asp-area="" title="Click link to Refer to the UJ Tariff Plan" asp-controller="Home" asp-action="GetTraffifPlan" style="color: blue; text-decoration:underline" target="_blank"><sup>UJ Tariff</sup></a></th>

                                                <th style="width:150px">Total For The Month</th>

                                                <th></th>
                                            </tr>

                                        </thead>

                                        <tbody>
                        @if (paymentcount > 0)
                        {

                                                                        <tr>
                                                                            <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px;display:none">
                                                                                      <input type="text" id="txtStudyType" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />
                                                                            </td>
                                                                            <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                                                <input type="text" id="txtStudyType" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                                            </td>

                                                                            <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                                                <input type="text" min="" id="txtFrom" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                                            </td>

                                                                            <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                                                <input type="text" id="txtTo" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                                            </td>


                                                                            <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                                                <input type="number" id="txtNumberOfWeeks" pattern="[0-9]{10}" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                                            </td>

                                                                            <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                                                <input type="number" id="txtHrsPerWeek" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                                            </td>


                                                                            <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                                                <input type="text" id="txtNumberOfHours" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                                            </td>

                                                                            <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                                                <input type="text" id="txtUJRatePerHr" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                                            </td>

                                                                            <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                                                <input type="text" id="txtMonthTotal" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                                            </td>

                                                                            <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">
                                                                                <input type="button" value="Remove" onclick="RemovePayment(this)" />
                                                                            </td>
                                                                        </tr>
                        }
                                        </tbody>
                                        <tfoot>

                                            <tr>
                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">


                                                    <select style="height:42px" name="txtStudyType"
                                                            id="txtStudyType">
                                                        <option value="Lecturer">Lecturer</option>
                                                        <option value="Tutor">Tutor</option>
                                                        <option value="Marking">Marking</option>
                                                        <option value="Research Assistant">Research Assistant</option>
                                                        <option value="Other">Other</option>
                                                    </select>


                                                </td>

                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                    <input type="date" defaultValue="@dtToday" max="@dtLastDay" min="@dtToday" id="txtFrom" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                </td>

                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                    <input type="date" defaultValue="@dtToday" max="@dtLastDay" min="@dtToday" id="txtTo" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                </td>

                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                    <input type="number" placeholder="Number of weeks" id="txtNumberOfWeeks" onkeyup="CalTotalHours()" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                </td>

                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                    <input type="number" placeholder="Hours per week" id="txtHrsPerWeek" onkeyup="CalTotalHours()" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                </td>

                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                    <input type="number" readonly id="txtNumberOfHours" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none; background-color: lightgray" />

                                                </td>

                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                    <input type="number" placeholder="UJ Rate Per Hour" step="1" id="txtUJRatePerHr" onkeyup="CalTotalForMonth()" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none;" />

                                                </td>

                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">

                                                    <input type="number" readonly id="txtMonthTotal" style="border-radius: 6px; border: 1px solid #E5E7E9;height: 42px; outline: none; background-color: lightgray" />

                                                </td>
                                                <td style="padding-right: 10px; padding-top:10px; padding-bottom:10px">
                                                    <input type="button" style="height:30px; width:68px" onclick="AddPaymentsRow()" id="btnAdd" value="Add" />
                                                </td>
                                            </tr>
                                        </tfoot>
                                    </table>

                                    <br />
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label for="PaymentTotal">Total</label>
                                            <input readonly id="PaymentTotal"
                                                   name="PaymentTotal"
                                                   type="number"
                                                   class="form-control" />

                                        </div>
                                        <br />
                                    </div>

                                </div>

                                <br />
                            </form>

                            <br />

                            <style>
    /* Chrome, Safari, Edge, Opera */
    input::-webkit-outer-spin-button,
    input::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }

    /* Firefox */
    input[type=number] {
        -moz-appearance: textfield;
    }
    </style>

</script>

