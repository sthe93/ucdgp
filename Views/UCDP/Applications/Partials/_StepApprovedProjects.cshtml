@using ResearchSuite.Models.UCDP.Shared
<div class="mb-4">

    @await Html.PartialAsync(
    "~/Views/UCDP/Applications/Shared/_StepSectionHeader.cshtml",
        new StepSectionHeaderViewModel
        {
            Title = "Projects attached to this funding call",
            Subtitle = "Select at least one approved DHET project"
        })

    <div id="FundingCallProjectsDiv"
         class="mt-3"
         data-fundingCallDetails-data='@Html.Raw(Json.Serialize(Model.FundingCallDetails.FundingCallProjects))'>

        <div class="text-muted small mb-3" id="SelectedProjectsDiv" data-SelectedProjects-data='@Html.Raw(Json.Serialize(Model.SelectedProjects))'>
          
        </div>

        <div class="row g-3">
            @if (Model.FundingCallDetails?.FundingCallProjects != null)
            {
                foreach (var item in Model.FundingCallDetails.FundingCallProjects)
                {
                    <div class="col-md-6">
                        <div class="form-check p-3 border rounded-3 h-100 project-card">
                            <input id="project_@item.Id"
                                   value="@item.Id"
                                   name="SelectedProjects"
                                   type="checkbox"
                                   class="form-check-input me-2">

                            <label for="project_@item.Id"
                                   class="form-check-label fw-medium">
                                @item.ProjectName
                            </label>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<div class="mt-4">
    @await Html.PartialAsync(
    "~/Views/UCDP/Applications/Shared/_StepWizardButtons.cshtml",
        new StepWizardButtonsViewModel
        {
            NextButtonId = "btnSaveProjects",
            NextButtonClass = "nextBtnApprove",
            CloseButtonId = "btnCloseApprove",
            BackButtonClass = "btnBackApprove",
            ShowBackButton = true
        })
</div>