
<div class="panel panel-primary setup-content" id="step-9">
    <div class="panel-heading" style="background-color: #FF6400">
        <h3 class="panel-title">  Supporting Information</h3>
    </div>

    <div class="panel-body">
        <div class="row">
            <div class="col-md-12">
                <div class="form-group">
                    <label for="Motivation">Motivation for financial support <i style="color:red">*</i></label>
                    <textarea required class="form-control" id="Motivation" name="Motivation" rows="4"></textarea>
                </div>
                <br />
            </div>

            <div class="col-md-12">
                <div class="form-group">
                    <label for="ProgressOfApplication">Progress of applicant in terms of the support applying for : Current progress of applicant towards goal (e.g. completion of dissertation, or article) Planned activities for the period that relief is requested)<i style="color:red">*</i></label>
                    <textarea required class="form-control" id="ProgressOfApplication" name="ProgressOfApplication" rows="4"></textarea>
                </div>
                <br />
            </div>

            <div class="col-md-12">
                <div class="form-group">
                    <label for="StateTheMeasurable">State the measurable output(s) impact to be achieved by applicant(s): (Example Article in an accredited Journal)<i style="color:red">*</i></label>
                    <textarea required class="form-control" id="StateTheMeasurable" rows="4"></textarea>
                </div>
                <br />
            </div>
        </div>

    </div>
    <br />

   

    <div class="panel-body">
        <div class="row">

            <div class="col-md-12">
                <button class="btn btn-success pull-right" id="btnSubmit" style="background-color: #9b51e0;" type="submit">Submit <i class="fa fa-send"></i></button>
                &nbsp;&nbsp;&nbsp;&nbsp;
                <button id="btnCloseSubmit" class="btn btn-primary" type="button" style="background-color: #7777; border-color: #7777; width:190px;"><i class="fa fa-close"></i> Close </button>
                <button class="btn btn-primary backBtnSubmit pull-right" type="button" style="background-color: #000000; border-color: #000000; width:190px; margin-right:75px"><i class="fa fa-arrow-left"></i> Back </button>
            </div>
            <br />
        </div>
    </div>
</div>