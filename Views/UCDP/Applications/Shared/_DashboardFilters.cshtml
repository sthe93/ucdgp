@model ResearchSuite.Models.UCDP.DashboardFilterViewModel

<div class="card border-0 shadow-sm mb-3 dashboard-filter-card">
	<div class="card-body p-3">
		<div class="row g-3 align-items-end">

			<div class="col-12 col-xl-6">
				<label class="form-label small mb-1 text-white" for="@Model.SearchId">Search</label>
				<div class="input-group dashboard-search-group">
					<input id="@Model.SearchId"
						   class="form-control"
						   placeholder="@Model.SearchPlaceholder" />

					<button class="btn btn-primary filter-btn"
							type="button"
							id="@Model.ApplyButtonId"
							aria-label="Search">
						<i class="bi bi-search"></i>
					</button>
				</div>
			</div>

			<div class="col-12 col-md-8 col-xl-4">
				<label class="form-label small mb-1 text-white" for="@Model.StatusId">Status</label>
				<select id="@Model.StatusId" class="form-select">
					<option value="all" selected>All</option>
					<option value="awaiting-first-line">Awaiting First Line Manager</option>
					<option value="awaiting-second-line">Awaiting Second Line Manager</option>
					<option value="awaiting-fund-admin">Awaiting Fund Administrator</option>
					<option value="awaiting-sia">Awaiting SIA Director</option>
					<option value="returned-for-info">Returned for Info</option>
					<option value="declined">Declined</option>
					<option value="award-accepted">Award Letter Accepted</option>
					<option value="award-declined">Award Letter Declined</option>
					<option value="approved-final">Awaiting Applicant (Award Letter Decision)</option>
					<option value="incomplete">Incomplete</option>
					<option value="expired-offer">Expired Offer</option>
				</select>
			</div>

			<div class="col-12 col-md-4 col-xl-2">
				<button class="btn btn-outline-secondary w-100 filter-btn"
						type="button"
						id="@Model.ClearButtonId">
					<i class="bi bi-arrow-counterclockwise me-1"></i> Clear
				</button>
			</div>

		</div>
	</div>
</div>