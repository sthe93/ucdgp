@model ResearchSuite.Models.UCDP.ApplicationDetailsViewModel
@using ResearchSuite.Helpers.Ucdp
@using ResearchSuite.Models.UCDP

@{
	Layout = "~/Views/Shared/_LayoutPrint.cshtml";

	string Safe(string value) => string.IsNullOrWhiteSpace(value) ? "-" : value;

	string Mask(string value, int keep)
	{
		if (string.IsNullOrWhiteSpace(value) || value.Length <= keep)
			return "*******";

		return value.Substring(0, value.Length - keep) + "*******";
	}

	bool HasProject(int id) => Model.SelectedProjects?.Any(x => x.ProjectId == id) == true;

	var uploadedDocs = Model.UploadedDocs ?? new List<UploadDocumentViewModel>();

	IEnumerable<UploadDocumentViewModel> Docs(params string[] types)
	{
		return uploadedDocs.Where(x =>
			!string.IsNullOrWhiteSpace(x.UploadType) &&
			types.Contains(x.UploadType.Trim()));
	}

	bool IsRadioSelected(string value, string selectedValue)
	{
		return !string.IsNullOrWhiteSpace(selectedValue)
			&& selectedValue.Trim().Equals(value, StringComparison.OrdinalIgnoreCase);
	}

	bool IsCheckboxSelected(string value, IEnumerable<string> selectedValues)
	{
		if (selectedValues == null)
			return false;

		var selectedItems = selectedValues
			.Where(x => !string.IsNullOrWhiteSpace(x))
			.SelectMany(x => x.Split(',', StringSplitOptions.RemoveEmptyEntries))
			.Select(x => x.Trim());

		return selectedItems.Any(x =>
			x.Equals(value, StringComparison.OrdinalIgnoreCase));
	}
	string Check(bool selected) => selected ? "☑" : "☐";
	string Radio(bool selected) => selected ? "◉" : "○";

	string FormatCurrency(object value)
	{
		if (value == null)
			return "R0.00";

		var text = value.ToString();

		if (string.IsNullOrWhiteSpace(text))
			return "R0.00";

		text = text.Replace("R", "")
				   .Replace(",", "")
				   .Trim();

		if (decimal.TryParse(
			text,
			System.Globalization.NumberStyles.Any,
			System.Globalization.CultureInfo.InvariantCulture,
			out var amount))
		{
			return "R" + amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);
		}

		return "R0.00";
	}

	string FormatDecimal(object value)
	{
		if (value == null)
			return "0.00";

		var text = value.ToString()?.Trim();

		if (string.IsNullOrWhiteSpace(text))
			return "0.00";

		text = text.Replace("R", "").Replace(" ", "");

		if (text.Contains(",") && !text.Contains("."))
			text = text.Replace(",", ".");
		else
			text = text.Replace(",", "");

		if (decimal.TryParse(
			text,
			System.Globalization.NumberStyles.Any,
			System.Globalization.CultureInfo.InvariantCulture,
			out var amount))
		{
			return amount.ToString("N2", System.Globalization.CultureInfo.InvariantCulture);
		}

		return "0.00";
	}

	string FormatRate(decimal? value)
	{
		if (!value.HasValue)
			return "R0.00";

		return "R" + value.Value.ToString(
			"#,##0.00",
			System.Globalization.CultureInfo.InvariantCulture
		);
	}
}


